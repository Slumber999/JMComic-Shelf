<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.jmcomic_shelf" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- jm-tools: system-bars -->
        <!-- 状态栏/导航栏跟应用背景一致（白底深色图标），去掉主题默认主色造成的蓝/紫边 -->
